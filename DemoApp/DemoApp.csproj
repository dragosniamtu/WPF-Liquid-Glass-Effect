<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XamlTemplates.FX.Wpf" Version="1.0.0-preview.3" />
  </ItemGroup>

  <ItemGroup>
    <XamlTemplatesFxShader Include="Shaders\LiquidGlassSample.glsl" />
    <None Update="Shaders\LiquidGlassSample.glsl" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
