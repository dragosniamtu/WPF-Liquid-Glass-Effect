<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:DemoApp.Behaviors"
                    xmlns:commands="clr-namespace:DemoApp.Commands"
                    xmlns:shaders="clr-namespace:DemoApp.Shaders"
                    xmlns:windowEffect="clr-namespace:DemoApp.WindowEffect">

    <shaders:GlassyEffect x:Key="GlassyEffect" x:Shared="False" />

    <Style x:Key="WindowFrameBorder" TargetType="Border">
        <Setter Property="windowEffect:WindowsSystemInfo.IsWindowsSystemTransparencyEnabled" Value="True" />
        <Setter Property="BorderBrush" Value="#55FFFFFF" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="#18000000" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="windowEffect:WindowsSystemInfo.IsWindowsSystemTransparencyEnabled" Value="False">
                <Setter Property="Background" Value="#66000000" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <DropShadowEffect x:Key="WindowShadowEffect"
                      BlurRadius="16"
                      ShadowDepth="6"
                      Opacity="0.35"
                      Color="#000000" />

    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Background" Value="#FFBD2E" />
        <Setter Property="BorderBrush" Value="#DCA529" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#66000000" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Tag" Value="M 3 7 L 11 7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Root"
                                 Fill="{TemplateBinding Background}"
                                 Stroke="{TemplateBinding BorderBrush}"
                                 StrokeThickness="{TemplateBinding BorderThickness}" />
                        <Path x:Name="Glyph"
                              Data="{TemplateBinding Tag}"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.7"
                              Fill="{TemplateBinding Foreground}"
                              Stretch="Fill"
                              Width="8"
                              Height="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Background" Value="#FF5F57" />
        <Setter Property="BorderBrush" Value="#E0443E" />
        <Setter Property="Foreground" Value="#7A1818" />
        <Setter Property="Tag" Value="M 2 2 L 12 12 M 12 2 L 2 12" />
    </Style>

    <Style x:Key="MaximizeCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="#28C840" />
        <Setter Property="BorderBrush" Value="#19AC34" />
        <Setter Property="Foreground" Value="#0B7424" />
        <Setter Property="Tag" Value="M 3 3 L 11 3 L 11 11 Z" />
    </Style>

    <Style x:Key="GlassyWindowStyle" TargetType="Window">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="behaviors:GlassyWindowBehavior.Enable" Value="True" />
        <Setter Property="windowEffect:AcrylicBlur.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border x:Name="ShadowHost"
                            Margin="0"
                            Background="Transparent">
                        <Border.Effect>
                            <StaticResource ResourceKey="WindowShadowEffect" />
                        </Border.Effect>
                        <Border x:Name="WindowFrame"
                                Style="{StaticResource WindowFrameBorder}"
                                commands:WindowCommands.DragMove="True">
                            <Grid x:Name="WindowClipRoot"
                                  ClipToBounds="True">
                                <Border x:Name="GlassyLayer"
                                        CornerRadius="0"
                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}}"
                                        Effect="{StaticResource GlassyEffect}" />

                                <Border CornerRadius="0"
                                        Background="#4DFFFFFF">
                                    <ContentPresenter />
                                </Border>

                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           Margin="116,11,116,0"
                                           Text="{TemplateBinding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#B0202022"
                                           IsHitTestVisible="False" />

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="18,16,0,0">
                                    <Button Style="{StaticResource CloseCaptionButtonStyle}"
                                            commands:WindowCommands.Close="True" />
                                    <Button Style="{StaticResource CaptionButtonStyle}"
                                            commands:WindowCommands.Minimize="True" />
                                    <Button x:Name="MaximizeButton"
                                            commands:WindowCommands.MaximizeRestore="True"
                                            Style="{StaticResource MaximizeCaptionButtonStyle}" />
                                </StackPanel>

                                <Border IsHitTestVisible="False"
                                        CornerRadius="0"
                                        BorderThickness="2">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#80FFFFFF" Offset="0" />
                                            <GradientStop Color="#40A6E1FF" Offset="0.35" />
                                            <GradientStop Color="#40FFB3E1" Offset="0.65" />
                                            <GradientStop Color="#80FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                </Border>

                                <Border BorderThickness="6"
                                        BorderBrush="Transparent"
                                        commands:WindowCommands.Resize="True" />
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="ShadowHost" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
